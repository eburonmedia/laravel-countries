{
    "name": "eburonmedia/laravel-countries",
    "description": "A reusable Laravel package that provides a countries database table, model, migration and seeder.",
    "version": "1.0.0",
    "keywords": [
        "laravel",
        "countries",
        "iso-3166",
        "seeder"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Eburonmedia\\LaravelCountries\\": "src/",
            "Eburonmedia\\LaravelCountries\\Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Eburonmedia\\LaravelCountries\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Eburonmedia\\LaravelCountries\\LaravelCountriesServiceProvider"
            ],
            "aliases": {
                "Countries": "Eburonmedia\\LaravelCountries\\Facades\\Countries"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
